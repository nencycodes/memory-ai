{
  "manifest_version": 3,
  "name": "MEMORY",
  "version": "0.1.1",
  "description": "A privacy-first personal memory for saved pages and local documents.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}